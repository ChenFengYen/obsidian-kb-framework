# obsidian-kb-framework v2 configuration
vault_name: "My Research KB"
language: "zh-TW"

# Each entry creates OV-{name}/Map, Note, and Pic.
domains:
  Bioinformatics:
    description: "生物資訊與生命科學"
    keywords: [bioinformatics, genomics, plant biology]
  MachineLearning:
    description: "機器學習與電腦視覺"
    keywords: [machine learning, deep learning, computer vision]

default_domain: "MachineLearning"

# Used only by the optional paper figure tools.
section_markers:
  - "# 基本資訊"
  - "# 研究方法"
  - "# 結果"
  - "# 討論"
figures_section: "## 圖表整理"
figure_extraction:
  min_width: 500
  portrait_aspect_range: [0.7, 1.4]
  graphical_abstract_min_width: 800

# Knowledge changes remain proposal-first. No automatic link injection.
capture:
  mode: "inline+debrief"  # debrief | inline+debrief | journal+debrief

modules:
  zotero: false
  paper_pipeline: false

learning:
  goals: []
  current_focus: ""
  experience_level: "beginner"

user_profile:
  research_areas: []
  knowledge_gaps: []

preferences:
  note_language: "zh-TW"
  moc_style: "narrative"
  link_format: "citekey"
  link_policy: "manual-semantic"
