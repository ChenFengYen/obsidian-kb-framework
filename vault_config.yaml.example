# ============================================================
# vault_config.yaml — Knowledge Base Configuration
# ============================================================
# This is the single configuration file for the framework.
# Generated by setup.py or manually edited.
# All scripts read from this file via framework/config.py.
# ============================================================

vault_name: "My Research KB"
language: "zh-TW"   # zh-TW | en — affects template section headers

# ── Domain Structure ─────────────────────────────────────────
# Each domain becomes an OV-{key} folder with Map/, Note/, Pic/
# keywords: used for routing papers/notes to the correct domain
domains:
  Bioinformatics:
    description: "生物資訊/植物生理/育種"
    keywords:
      - "bioinformatics"
      - "genomics"
      - "genetics"
      - "plant biology"
      - "plant sciences"
      - "plant physiology"
      - "molecular biology"
      - "agronomy"
      - "stress biology"
      - "crop science"
      - "breeding"
  MachineLearning:
    description: "機器學習/電腦視覺"
    keywords:
      - "machine learning"
      - "deep learning"
      - "computer vision"
      - "artificial intelligence"
      - "object detection"
      - "image segmentation"
      - "neural networks"
      - "natural language processing"
      - "transformer"
      - "image classification"
      - "remote sensing"
  Pheno:
    description: "植物表型分析"
    keywords:
      - "plant phenotyping"
      - "phenotyping"
      - "phenomics"
      - "high-throughput phenotyping"
      - "image-based phenotyping"
  Software:
    description: "軟體工程/程式設計"
    keywords:
      - "software engineering"
      - "programming"
      - "web development"
      - "api"
  Database:
    description: "資料庫"
    keywords:
      - "database"
      - "data management"
  Docker:
    description: "容器/DevOps"
    keywords:
      - "docker"
      - "devops"
      - "containerization"
  Git:
    description: "版本控制"
    keywords:
      - "version control"
      - "git"
  Hardware:
    description: "硬體/感測器"
    keywords:
      - "hardware"
      - "sensors"
      - "imaging systems"

default_domain: "MachineLearning"

# ── Paper Template Section Markers ───────────────────────────
# Emoji+text markers delimiting paper sections (used by inject_links, extract_figures)
section_markers:
  - "# 🧾 基本資訊"
  - "# 🎯 研究主題與背景"
  - "# 💡 創新與貢獻"
  - "# 🔬 研究方法"
  - "# 📊 結果"
  - "# 🧠 討論"
  - "# 🧩 補充分析"
  - "# 🧭 與我的研究關聯"
figures_section: "## 圖表整理"

# ── Figure Extraction Settings ───────────────────────────────
figure_extraction:
  min_width: 500
  portrait_aspect_range: [0.7, 1.4]
  graphical_abstract_min_width: 800

# ── Concept Filtering ────────────────────────────────────────
filtering:
  # Terms too generic to become concept notes
  generic_blocklist:
    - "數據分析"
    - "統計分析"
    - "數據採集"
    - "數據處理"
    - "數據預處理"
    - "數據標註"
    - "數據增強"
    - "數據標準化"
    - "數據處理流程"
    - "影像預處理"
    - "圖像預處理"
    - "圖像處理"
    - "圖像採集"
    - "模型架構"
    - "模型選擇"
    - "模型評估"
    - "核心模型"
    - "評估指標"
    - "性能評估"
    - "實驗驗證"
    - "實驗設計"
    - "特徵提取"
    - "特徵選擇"
    - "特徵工程"
    - "架構改進"
    - "訓練策略"
    - "學習率"
    - "損失函數"
    - "植物材料"
    - "生長條件"
    - "數據集"
    - "資料集"
    - "通用性"
    - "全面性"
    - "可擴展性"
    - "可解釋性"
    - "高通量表型分析"
    - "生長監測"
    - "預處理"

  # Boost patterns: terms matching these get 1.5x candidate score
  # Typically your knowledge-gap area
  boost_patterns:
    - "photosyn"
    - "chlorophyll"
    - "stomata"
    - "transpir"
    - "water use"
    - "drought"
    - "heat stress"
    - "abiotic"
    - "biotic stress"
    - "fluoresc"
    - "gas exchange"
    - "nitrogen"
    - "canopy"
    - "spectral"
    - "ndvi"
    - "pigment"
    - "senescence"
    - "phenolog"
    - "biomass"
    - "leaf area"
    - "osmotic"
    - "oxidative"
    - "salinity"
    - "rubisco"
    - "thylakoid"
    - "chloroplast"
    - "anthocyanin"
    - "carotenoid"
    - "nutrient"
    - "deficiency"
    - "acclimat"
    - "toleran"
    - "resilien"
    # Chinese
    - "光合"
    - "葉綠素"
    - "氣孔"
    - "蒸散"
    - "水分利用"
    - "乾旱"
    - "逆境"
    - "螢光"
    - "營養"
    - "馴化"
    - "qtl"
    - "gwas"
    - "snp"
    - "基因"
    - "遺傳"
    - "育種"

  # English words that should not be treated as concept aliases
  alias_blocklist:
    - "database"
    - "table"
    - "tables"
    - "field"
    - "fields"
    - "record"
    - "records"
    - "function"
    - "import"
    - "class"
    - "method"
    - "module"
    - "object"
    - "value"
    - "input"
    - "output"
    - "error"
    - "model"
    - "system"
    - "process"
    - "design"
    - "result"
    - "results"
    - "analysis"
    - "performance"
    - "approach"
    - "data"
    - "feature"
    - "features"
    - "weight"
    - "training"
    - "testing"
    - "prediction"
    - "classification"
    - "detection"
    - "estimation"
    - "distribution"
    - "evaluation"
    - "optimization"
    - "regression"
    - "structure"
    - "network"
    - "layer"
    - "image"
    - "images"
    - "deep learning"
    - "normalization"
    - "attention"
    - "embedding"
    - "backbone"

  stem_blocklist: ["uv", "id", "ip", "os", "io"]
  min_alias_length: 12

# ── Link Injection ───────────────────────────────────────────
link_injection:
  # Directories to scan for link injection (relative to vault root)
  # "all" scans every .md file; list specific dirs for targeted scanning
  scan_dirs:
    - "OV-Papers/PDF-md"
  # Set to true to also scan concept notes in OV-*/Note/
  # scan_dirs: "all"

# ── Enrichment ───────────────────────────────────────────────
enrichment:
  style_reference: null   # Path to a well-structured note for style examples, or null
  target_level: "basic"   # "basic" (10-15 lines) or "rich" (≥30 lines)
  batch_size: 10

# ── Knowledge Capture ────────────────────────────────────────
capture:
  mode: "inline+debrief"
  # debrief: only review insights at session end
  # inline+debrief: AI flags insights during conversation + end review (default)
  # journal+debrief: create exploration journal notes + end review

# ── Optional Modules ─────────────────────────────────────────
modules:
  zotero: false           # Enable Zotero integration
  paper_pipeline: false   # Enable paper processing (figures, status tracking)

# ── Learning State (AI agent uses this) ──────────────────────
learning:
  goals: []
    # - "Understand molecular mechanisms of plant stress"
    # - "Master image processing pipelines for phenotyping"
  current_focus: ""       # AI prioritizes this direction
  experience_level: "beginner"
  # beginner: AI explains concepts, proactively suggests structure
  # intermediate: AI focuses on knowledge gaps, assists deepening
  # advanced: AI follows user's lead, discussion-centric

# ── User Profile (for CLAUDE.md generation) ──────────────────
user_profile:
  research_areas: []
    # - "Plant Phenotyping"
    # - "Computer Vision"
  knowledge_gaps: []
    # - "Plant Physiology"

# ── Preferences ──────────────────────────────────────────────
preferences:
  note_language: "zh-TW"
  moc_style: "narrative"     # narrative | index
  link_format: "citekey"     # citekey | alias
  auto_rescan: true          # Auto rescan after creating concept notes
