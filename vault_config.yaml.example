vault_name: My Knowledge Base
language: en

domains:
  General:
    description: General knowledge and cross-domain questions
    keywords: []

default_domain: General

learning:
  experience_level: intermediate
  current_focus: null
  goals: []

user_profile:
  areas: []
  knowledge_gaps: []

conventions:
  # core and obsidian are recommended defaults.
  # Add research or windows-zh-tw only when applicable.
  packs:
    - core
    - obsidian

modules:
  zotero: false
  paper_pipeline: false

agent:
  # Codex and other AGENTS-aware tools read AGENTS.md directly.
  adapters:
    - claude
    - gemini
    - legacy

filtering:
  generic_blocklist: []
  boost_patterns: []
  alias_blocklist: []
  stem_blocklist: [id, io, os]
  min_alias_length: 12
